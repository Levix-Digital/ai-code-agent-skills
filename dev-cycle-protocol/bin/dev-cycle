#!/bin/sh
# Runs the dev-cycle binary of this skills version (the commands translated from the Python
# scripts, IMP-005). Linux, macOS and Git Bash on Windows; PowerShell uses dev-cycle.ps1.
#
# The binary comes from, in order: DEV_CYCLE_BIN; the cache; the engine-v<version> release
# (checked against its SHA256SUMS); a build with cargo when this folder is inside a checkout.
set -eu

REPO="Levix-Digital/ai-code-agent-skills"
here=$(cd "$(dirname "$0")" && pwd -P)
version=$(tr -d ' \r\n' < "$here/engine-version")

if [ -n "${DEV_CYCLE_BIN:-}" ]; then
  exec "$DEV_CYCLE_BIN" "$@"
fi

os=$(uname -s)
case "$(uname -m)" in
  x86_64|amd64) arch=x86_64 ;;
  aarch64|arm64) arch=aarch64 ;;
  *) arch=unknown ;;
esac
exe=""
case "$os" in
  Linux) target="$arch-unknown-linux-musl" ;;
  Darwin) target="$arch-apple-darwin" ;;
  MINGW*|MSYS*|CYGWIN*) target="$arch-pc-windows-msvc"; exe=".exe" ;;
  *) target="" ;;
esac

if [ -n "${LOCALAPPDATA:-}" ]; then
  cache_root=$(printf '%s' "$LOCALAPPDATA" | sed 's|\\|/|g')
elif [ -n "${XDG_CACHE_HOME:-}" ]; then
  cache_root="$XDG_CACHE_HOME"
else
  cache_root="$HOME/.cache"
fi
cache="$cache_root/dev-cycle/engine-v$version"
bin="$cache/dev-cycle$exe"

if [ ! -x "$bin" ] && [ -n "$target" ]; then
  url="https://github.com/$REPO/releases/download/engine-v$version"
  asset="dev-cycle-$target$exe"
  tmp="$cache.tmp.$$"
  mkdir -p "$tmp"
  fetch() {
    if command -v curl >/dev/null 2>&1; then curl -fsSL -o "$2" "$1"; else wget -q -O "$2" "$1"; fi
  }
  if fetch "$url/$asset" "$tmp/$asset" 2>/dev/null && fetch "$url/SHA256SUMS" "$tmp/SHA256SUMS" 2>/dev/null; then
    expected=$(grep " $asset\$" "$tmp/SHA256SUMS" | cut -d' ' -f1)
    if command -v sha256sum >/dev/null 2>&1; then
      actual=$(sha256sum "$tmp/$asset" | cut -d' ' -f1)
    else
      actual=$(shasum -a 256 "$tmp/$asset" | cut -d' ' -f1)
    fi
    if [ -n "$expected" ] && [ "$expected" = "$actual" ]; then
      chmod +x "$tmp/$asset"
      mkdir -p "$cache"
      mv "$tmp/$asset" "$bin"
    else
      echo "dev-cycle: checksum mismatch for $asset of engine-v$version; not used" >&2
    fi
  fi
  rm -rf "$tmp"
fi

if [ ! -x "$bin" ]; then
  root=$(cd "$here/../.." && pwd -P)
  if [ -f "$root/Cargo.toml" ] && command -v cargo >/dev/null 2>&1; then
    cargo build --quiet --release --locked -p dev-cycle --manifest-path "$root/Cargo.toml" >&2
    bin="$root/target/release/dev-cycle$exe"
  else
    echo "dev-cycle: no binary of engine-v$version for this system (${target:-$os $(uname -m)})." >&2
    echo "Download it from https://github.com/$REPO/releases/tag/engine-v$version, or install Rust and run this again from a checkout." >&2
    exit 127
  fi
fi

exec "$bin" "$@"
