{
  "project_name": "dev-cycle-protocol",
  "test_commands": [
    "cargo test --workspace",
    "cargo build -p dev-cycle",
    "cargo run -p parity -- run"
  ],
  "docs": {
    "user_doc": "README.md"
  },
  "tests": {
    "manual_tests": "tests/MANUAL_TESTS.md"
  },
  "devops": {
    "branching": "trunk",
    "production_branch": "main",
    "version_files": [
      ".claude-plugin/plugin.json"
    ]
  },
  "speckit": {
    "enabled": true,
    "version": "v1.3.2",
    "integration": "claude",
    "script": "sh",
    "branch_prefix": "feat"
  },
  "architecture": {
    "style": "modular-monolith"
  }
}
