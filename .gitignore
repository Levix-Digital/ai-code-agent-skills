# Allowlist: only what is listed below is versioned.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/crates/
!/.claude-plugin/
!/.claude/
!/.dev-cycle.json
!/.specify/
!/specs/
!/README.md
!/TECDOC.md
!/install.ps1
!/install.sh
!/requirements.txt
!/tests/
!/docs/
!/architecture-docs/
!/backlog/
!/code-review/
!/dev-cycle-protocol/
!/dev-cycle/
!/devops-release/
!/folder-sync/
!/gedo-feedback/
!/plan-memory/
!/product-inception/
!/quality-assurance/
!/session-memory/
!/software-design/
!/user-docs/

# Data, state and environments are never versioned
db/
chroma_db/
__pycache__/
*.pyc
.venv/
node_modules/
target/
.env
*.sqlite3
# Parity fixtures: local store databases the commands read
!tests/parity/fixtures/**/*.sqlite3
