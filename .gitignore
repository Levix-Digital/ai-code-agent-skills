# Allowlist: only what is listed below is versioned.
/*
!/.gitignore
!/.gitattributes
!/.claude-plugin/
!/README.md
!/install.ps1
!/install.sh
!/requirements.txt
!/docs/
!/architecture-docs/
!/dev-cycle-protocol/
!/folder-sync/
!/plan-memory/
!/quality-assurance/
!/session-memory/
!/software-design/
!/user-docs/

# Data, state and environments are never versioned
db/
chroma_db/
__pycache__/
*.pyc
.venv/
node_modules/
.env
*.sqlite3
